  "cyber_lion": {
    "tile_id": "execution-mesh.swarm",
    "roles": [
      "ExecutionMesh",
      "WorkloadRuntime",
      "TelemetryPlane",
      "CapabilityLeaseRuntime"
    ],
    "layers": [
      "INF",
      "MAND"
    ],
    "disposition": [
      "KEEP",
      "REFINE",
      "GENERALIZE",
      "INTEGRATE"
    ]
  },
  "capabilities": [
    "workload.execute",
    "workload.identity",
    "capability.lease",
    "runtime.observe",
    "runtime.receipt",
    "swarm.reconfigure"
  ],
  "authority": {
